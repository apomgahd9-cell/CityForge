{
  "schemaVersion": 1,
  "version": 1,
  "description": "City finances: tax policy, revenues, expenses, loans, and budget.",
  "initialState": {
    "startingFunds": 50000,
    "description": "Funds when a new city is founded."
  },
  "budgetCycle": {
    "period": "monthly",
    "description": "Budget is calculated once per game month."
  },
  "taxPolicy": {
    "residential": {
      "defaultRate": 7,
      "minRate": 0,
      "maxRate": 20,
      "rateStep": 0.5,
      "description": "Tax rate for residential buildings."
    },
    "commercial": {
      "defaultRate": 7,
      "minRate": 0,
      "maxRate": 20,
      "rateStep": 0.5,
      "description": "Tax rate for commercial buildings."
    },
    "industrial": {
      "defaultRate": 7,
      "minRate": 0,
      "maxRate": 20,
      "rateStep": 0.5,
      "description": "Tax rate for industrial buildings."
    }
  },
  "revenue": {
    "taxIncome": {
      "description": "Monthly tax revenue.",
      "sources": {
        "residential": {
          "function": "linear",
          "metric": "population_total",
          "weight": 0.1,
          "taxSource": "taxPolicy.residential"
        },
        "commercial": {
          "function": "linear",
          "metric": "commercial_demand",
          "weight": 2.0,
          "taxSource": "taxPolicy.commercial"
        },
        "industrial": {
          "function": "linear",
          "metric": "freight_access",
          "weight": 3.0,
          "taxSource": "taxPolicy.industrial"
        }
      }
    },
    "serviceFees": {
      "enabled": false,
      "water": { "function": "linear", "metric": "population_total", "weight": 0.02 },
      "electricity": { "function": "linear", "metric": "population_total", "weight": 0.03 }
    }
  },
  "expenses": {
    "serviceMaintenance": {
      "police": { "baseCost": 100, "scaling": { "metric": "population_total", "weight": 0.01 } },
      "fire": { "baseCost": 80, "scaling": { "metric": "population_total", "weight": 0.008 } },
      "health": { "baseCost": 150, "scaling": { "metric": "population_total", "weight": 0.015 } },
      "education": { "baseCost": 120, "scaling": { "metric": "population_total", "weight": 0.012 } },
      "water": { "baseCost": 50, "scaling": null },
      "electricity": { "baseCost": 70, "scaling": null }
    },
    "loanInterest": {}
  },
  "loan": {
    "maxAmount": 100000,
    "interestRate": 0.05,
    "minPayment": 500
  },
  "financialState": {
    "bankruptcyThreshold": -50000
  },
  "demolitionRefundRate": 0.5
}
